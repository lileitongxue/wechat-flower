{
  "miniprogramRoot": "miniprogram/",
  "cloudfunctionRoot": "cloudfunctions/",
  "projectname": "wechat-flower",
  "description": "花知道 · 花店小程序（商城 + 预约）",
  "appid": "touristappid",
  "compileType": "miniprogram",
  "libVersion": "3.4.0",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "coverView": true,
    "lazyloadPlaceholderEnable": false,
    "preloadBackgroundData": false,
    "nodeModules": false,
    "showShadowRootInWxmlPanel": true,
    "useStaticServer": false,
    "useApiHook": true,
    "useApiHostProcess": true,
    "useIsolateContext": true,
    "userConfirmedBundleSwitch": false,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "useCompilerPlugins": false,
    "ignoreUploadUnusedFiles": true
  },
  "condition": {
    "miniprogram": {
      "list": [
        { "name": "首页", "pathName": "pages/index/index", "query": "", "scene": null },
        { "name": "管理台", "pathName": "pages/admin/dashboard/dashboard", "query": "", "scene": null }
      ]
    }
  }
}
