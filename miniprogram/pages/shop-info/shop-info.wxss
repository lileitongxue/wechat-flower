.page { height: 100vh; display: flex; flex-direction: column; }
.scroll { flex: 1; }
.hero {
  background: linear-gradient(160deg, #f8bbd0, #c2185b);
  color: #fff;
  padding: 56rpx 32rpx 64rpx;
  text-align: center;
}
.hero-icon { font-size: 80rpx; }
.hero-name { font-size: 38rpx; font-weight: 600; margin-top: 16rpx; }
.hero-time { font-size: 25rpx; opacity: 0.9; margin-top: 10rpx; }
.card { margin-top: -36rpx; }
.section-title ~ .card { margin-top: 20rpx; }
.cell-icon { font-size: 36rpx; margin-right: 20rpx; }
.info-row { display: flex; gap: 20rpx; padding: 14rpx 0; }
.info-key { color: var(--ink-3); font-size: 26rpx; width: 150rpx; flex-shrink: 0; }
.info-val { flex: 1; font-size: 26rpx; color: var(--ink-2); line-height: 1.6; }
.rules { padding: 24rpx; }
.rule { font-size: 25rpx; color: var(--ink-2); line-height: 2; }
