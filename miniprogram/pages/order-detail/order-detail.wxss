.page { height: 100vh; display: flex; flex-direction: column; }
.scroll { flex: 1; }

.status-head {
  padding: 48rpx 32rpx 56rpx;
  background: linear-gradient(135deg, #d81b60, #c2185b);
  color: #fff;
}
.status-head.warn { background: linear-gradient(135deg, #f0a35e, #e8833a); }
.status-head.done { background: linear-gradient(135deg, #3f7a68, #2e5d4f); }
.status-head.gray { background: linear-gradient(135deg, #8d8681, #6b625c); }
.status-text { font-size: 40rpx; font-weight: 600; }
.status-sub { font-size: 25rpx; opacity: 0.9; margin-top: 12rpx; }

/* 自提码 */
.pickup { margin-top: -32rpx; position: relative; text-align: center; }
.pickup-code {
  font-size: 68rpx;
  font-weight: 600;
  letter-spacing: 10rpx;
  color: var(--rose);
  margin: 16rpx 0;
  font-family: 'DIN Alternate', monospace;
}
.pickup-copy {
  position: absolute;
  top: 24rpx; right: 24rpx;
  font-size: 24rpx;
  color: var(--rose);
  border: 2rpx solid var(--rose);
  border-radius: 24rpx;
  padding: 4rpx 20rpx;
}

/* 地址 */
.addr { display: flex; gap: 18rpx; align-items: flex-start; }
.addr-icon { font-size: 36rpx; }
.addr-head { display: flex; gap: 20rpx; align-items: baseline; }
.addr-name { font-size: 30rpx; font-weight: 600; }
.addr-phone { font-size: 26rpx; color: var(--ink-2); }
.addr-detail { font-size: 26rpx; color: var(--ink-2); margin-top: 8rpx; line-height: 1.5; }

.express {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
  position: relative;
}
.express-call {
  position: absolute;
  right: 0; top: 24rpx;
  font-size: 24rpx;
  color: #fff;
  background: var(--green);
  border-radius: 24rpx;
  padding: 6rpx 24rpx;
}

/* 商品 */
.good {
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid var(--line);
}
.good-img {
  width: 130rpx; height: 130rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--rose-bg);
  flex-shrink: 0;
}
.good-img image { width: 100%; height: 100%; }
.good-img-ph {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 50rpx;
}
.good-name { font-size: 28rpx; line-height: 1.4; }
.good-right { text-align: right; display: flex; flex-direction: column; gap: 4rpx; }

.sum { padding: 20rpx 24rpx; }
.sum-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 27rpx;
}
.sum-row-total {
  border-top: 2rpx solid var(--line);
  margin-top: 12rpx;
  padding-top: 20rpx;
  align-items: baseline;
}
.sum-price { font-size: 38rpx; }

/* 订单信息 */
.meta-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 14rpx 0;
  font-size: 26rpx;
}
.meta-key { color: var(--ink-3); width: 140rpx; flex-shrink: 0; }
.meta-val { flex: 1; color: var(--ink-2); word-break: break-all; }
.meta-copy {
  color: var(--rose);
  font-size: 24rpx;
  border: 2rpx solid var(--rose);
  border-radius: 20rpx;
  padding: 2rpx 18rpx;
  flex-shrink: 0;
}

/* 时间线 */
.tl-item { display: flex; gap: 20rpx; position: relative; padding-bottom: 28rpx; }
.tl-item:last-child { padding-bottom: 0; }
.tl-dot {
  width: 18rpx; height: 18rpx;
  border-radius: 50%;
  background: #d5cfcb;
  margin-top: 10rpx;
  flex-shrink: 0;
  z-index: 1;
}
.tl-dot.active { background: var(--rose); box-shadow: 0 0 0 6rpx rgba(194, 24, 91, 0.12); }
.tl-line {
  position: absolute;
  left: 8rpx; top: 26rpx; bottom: 0;
  width: 2rpx;
  background: var(--line);
}
.tl-body { flex: 1; }

.help {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  margin: 20rpx 24rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.loading-wrap { padding-top: 40rpx; }
.loading-wrap .skeleton { display: block; }
