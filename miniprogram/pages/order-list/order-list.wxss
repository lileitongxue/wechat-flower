.page { height: 100vh; display: flex; flex-direction: column; }

.tabs {
  display: flex;
  background: #fff;
  border-bottom: 2rpx solid var(--line);
  flex-shrink: 0;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 27rpx;
  color: var(--ink-2);
  position: relative;
}
.tab.active { color: var(--rose); font-weight: 600; }
.tab.active::after {
  content: '';
  position: absolute;
  left: 50%; bottom: 0;
  transform: translateX(-50%);
  width: 44rpx; height: 4rpx;
  background: var(--rose);
  border-radius: 2rpx;
}
.tab-badge {
  position: absolute;
  top: 10rpx;
  right: 50%;
  margin-right: -52rpx;
  min-width: 28rpx; height: 28rpx;
  padding: 0 6rpx;
  background: var(--danger);
  color: #fff;
  font-size: 19rpx;
  line-height: 28rpx;
  border-radius: 14rpx;
}

.scroll { flex: 1; }
.wrap { padding: 20rpx 24rpx; }

.order {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  margin-bottom: 20rpx;
  overflow: hidden;
}
.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid var(--line);
}
.order-status { font-size: 26rpx; color: var(--ink-2); font-weight: 500; }
.order-status.warn { color: var(--warn); }
.order-status.done { color: var(--green); }

.order-goods { padding: 8rpx 24rpx; }
.order-good {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 14rpx 0;
}
.order-img {
  width: 110rpx; height: 110rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--rose-bg);
  flex-shrink: 0;
}
.order-img image { width: 100%; height: 100%; }
.order-img-ph {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
}
.order-name { font-size: 27rpx; }

.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 16rpx 24rpx;
  border-top: 2rpx solid var(--line);
}
.order-total { font-size: 32rpx; }

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 0 24rpx 20rpx;
}
.order-actions:empty { display: none; }
