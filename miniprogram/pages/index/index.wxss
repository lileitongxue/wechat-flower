.page { height: 100vh; display: flex; flex-direction: column; background: var(--bg); }

/* 自定义导航 */
.nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 200;
  background: linear-gradient(180deg, #fdf2f6, rgba(253, 242, 246, 0.94));
  backdrop-filter: blur(10px);
}
.nav-bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 20rpx;
}
.nav-logo {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--rose);
  letter-spacing: 2rpx;
  flex-shrink: 0;
}
.nav-search {
  flex: 1;
  height: 64rpx;
  background: #fff;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 10rpx;
}
.nav-search-icon { font-size: 26rpx; }
.nav-search-ph { font-size: 26rpx; color: var(--ink-3); }

.scroll { flex: 1; }

/* 轮播 */
.banner {
  height: 340rpx;
  margin: 20rpx 24rpx;
  border-radius: var(--radius);
  overflow: hidden;
}
.banner-img { width: 100%; height: 100%; }
.banner-ph {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #f8bbd0, #c2185b);
  display: flex;
  align-items: flex-end;
  padding: 36rpx;
}
.banner-ph-title { color: #fff; font-size: 38rpx; font-weight: 600; }

/* 快捷入口 */
.quick { display: flex; justify-content: space-around; padding: 28rpx 12rpx; }
.quick-item { display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.quick-icon {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 42rpx;
}
.quick-icon-rose { background: var(--rose-bg); }
.quick-icon-warn { background: #fdf0e5; }
.quick-icon-gold { background: #faf2e0; }
.quick-icon-green { background: #e8f1ee; }
.quick-text { font-size: 24rpx; color: var(--ink-2); }

/* 公告 */
.notice {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 0 24rpx;
  padding: 18rpx 24rpx;
  background: #fff7ea;
  border-radius: var(--radius-sm);
}
.notice-tag {
  font-size: 20rpx;
  color: #fff;
  background: var(--warn);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}
.notice-text { font-size: 24rpx; color: #8a6434; flex: 1; }

/* 分类 */
.cats {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  border-radius: var(--radius);
  margin: 20rpx 24rpx;
  padding: 24rpx 0;
  box-shadow: var(--shadow);
}
.cat-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 8rpx;
}
.cat-icon { font-size: 48rpx; }
.cat-name { font-size: 24rpx; color: var(--ink-2); max-width: 100%; }

/* 热销横滑 */
.section-more {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--ink-3);
  font-weight: 400;
}
.hot-scroll { white-space: nowrap; }
.hot-inner { display: inline-flex; padding: 0 24rpx; gap: 20rpx; }
.hot-item { width: 300rpx; flex-shrink: 0; }

/* 双列网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
  gap: 20rpx;
}
.grid-item { width: calc((100% - 20rpx) / 2); }

.empty-wrap {
  display: flex; flex-direction: column; align-items: center;
  padding: 100rpx 60rpx;
}
.empty-wrap .empty-icon { font-size: 100rpx; opacity: .5; }
.empty-wrap .empty-text { margin-top: 20rpx; color: var(--ink-2); }
.empty-wrap .empty-hint { margin-top: 8rpx; font-size: 24rpx; color: var(--ink-3); text-align: center; }

.foot-tip {
  text-align: center;
  color: var(--ink-3);
  font-size: 24rpx;
  padding: 48rpx 0 32rpx;
  letter-spacing: 2rpx;
}
