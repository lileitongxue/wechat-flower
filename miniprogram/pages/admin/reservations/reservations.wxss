.page { height: 100vh; display: flex; flex-direction: column; }
.tabs { background: #fff; border-bottom: 2rpx solid var(--line); white-space: nowrap; }
.tabs-inner { display: inline-flex; padding: 16rpx 24rpx; gap: 16rpx; }
.tab {
  padding: 10rpx 26rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  background: #f4f1ef;
  border-radius: 26rpx;
}
.tab.active { background: var(--rose); color: #fff; font-weight: 500; }

.scroll { flex: 1; }
.wrap { padding: 20rpx 24rpx; }

.r {
  background: #fff;
  border-radius: var(--radius);
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
  overflow: hidden;
}
.r-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 24rpx;
  background: linear-gradient(135deg, #fdf2f6, #fff);
}
.r-date { font-size: 32rpx; font-weight: 600; }
.r-time { font-size: 24rpx; color: var(--ink-3); margin-left: 14rpx; }
.r-status { font-size: 25rpx; font-weight: 500; }
.r-status.pending { color: var(--warn); }
.r-status.confirmed { color: var(--rose); }
.r-status.fulfilled { color: var(--green); }
.r-status.cancelled { color: var(--ink-3); }

.r-body { padding: 16rpx 24rpx; }
.kv { display: flex; align-items: flex-start; gap: 16rpx; padding: 8rpx 0; font-size: 25rpx; }
.k { color: var(--ink-3); width: 80rpx; flex-shrink: 0; }
.v { flex: 1; color: var(--ink-2); line-height: 1.5; }
.v-op {
  color: var(--rose);
  font-size: 22rpx;
  border: 2rpx solid var(--rose);
  border-radius: 18rpx;
  padding: 2rpx 14rpx;
  flex-shrink: 0;
}

.r-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  padding: 0 24rpx 20rpx;
}
