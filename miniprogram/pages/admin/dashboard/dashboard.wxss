.page { height: 100vh; display: flex; flex-direction: column; }
.scroll { flex: 1; }

.hero {
  background: linear-gradient(140deg, #c2185b, #8e1248);
  color: #fff;
  padding: 44rpx 32rpx 36rpx;
}
.hero-label { font-size: 25rpx; opacity: 0.85; }
.hero-amount {
  font-size: 68rpx;
  font-weight: 600;
  margin-top: 8rpx;
  font-family: 'DIN Alternate', sans-serif;
}
.hero-row {
  display: flex;
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
}
.hero-item { flex: 1; text-align: center; }
.hero-num { display: block; font-size: 34rpx; font-weight: 600; }
.hero-sub { display: block; font-size: 22rpx; opacity: 0.8; margin-top: 6rpx; }

.todos {
  display: flex;
  background: #fff;
  margin: 0 24rpx;
  border-radius: var(--radius);
  padding: 28rpx 0;
  box-shadow: var(--shadow);
}
.todo { flex: 1; text-align: center; }
.todo-num {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink-3);
  font-family: 'DIN Alternate', sans-serif;
}
.todo-num.hot { color: var(--rose); }
.todo-label { font-size: 23rpx; color: var(--ink-2); margin-top: 4rpx; }

.cell-icon { font-size: 34rpx; margin-right: 18rpx; }

.low {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid var(--line);
}
.low:last-child { border-bottom: none; }
.low-img {
  width: 76rpx; height: 76rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: var(--rose-bg);
  flex-shrink: 0;
}
.low-img image { width: 100%; height: 100%; }
.low-img-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 34rpx; }
.low-stock { font-size: 25rpx; color: var(--warn); flex-shrink: 0; }
.low-stock.out { color: var(--danger); }
.low-add {
  font-size: 24rpx;
  color: #fff;
  background: var(--rose);
  border-radius: 24rpx;
  padding: 6rpx 22rpx;
  flex-shrink: 0;
}
