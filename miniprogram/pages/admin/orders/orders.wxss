.page { height: 100vh; display: flex; flex-direction: column; }
.filters { background: #fff; border-bottom: 2rpx solid var(--line); }
.search {
  display: flex; align-items: center;
  margin: 16rpx 24rpx;
  height: 68rpx;
  background: #f4f1ef;
  border-radius: 34rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}
.search-clear { color: var(--ink-3); padding: 0 8rpx; }
.tabs { white-space: nowrap; }
.tabs-inner { display: inline-flex; padding: 0 24rpx 16rpx; gap: 16rpx; }
.tab {
  padding: 10rpx 26rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  background: #f4f1ef;
  border-radius: 26rpx;
}
.tab.active { background: var(--rose); color: #fff; font-weight: 500; }

.scroll { flex: 1; }
.wrap { padding: 20rpx 24rpx; }

.o {
  background: #fff;
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}
.o-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--line);
}
.o-no { font-size: 24rpx; color: var(--ink-3); font-family: monospace; }
.o-status { font-size: 26rpx; font-weight: 600; color: var(--ink-2); }
.o-status.warn { color: var(--warn); }
.o-status.hot { color: var(--rose); }
.o-status.done { color: var(--green); }
.o-status.gray { color: var(--ink-3); }

.o-info { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; }
.o-type { font-size: 25rpx; font-weight: 500; }
.o-addr { margin-top: 6rpx; }

.o-goods { margin-top: 14rpx; display: flex; flex-direction: column; gap: 4rpx; }
.o-good { line-height: 1.5; }

.o-foot {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--line);
}
.o-total { font-size: 32rpx; }

.o-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}
