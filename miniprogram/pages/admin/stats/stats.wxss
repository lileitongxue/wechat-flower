.page { height: 100vh; display: flex; flex-direction: column; }
.scroll { flex: 1; }

.range {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 2rpx solid var(--line);
}
.range-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 25rpx;
  color: var(--ink-2);
  background: #f4f1ef;
  border-radius: 26rpx;
}
.range-item.active { background: var(--rose); color: #fff; font-weight: 500; }

.sum { display: flex; }
.sum-item { flex: 1; text-align: center; }
.sum-num {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--rose);
  font-family: 'DIN Alternate', sans-serif;
}
.sum-label { display: block; font-size: 22rpx; color: var(--ink-3); margin-top: 8rpx; }

/* 纯 CSS 柱状图 */
.chart {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 360rpx;
  padding-top: 20rpx;
}
.bar-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}
.bar-value { font-size: 18rpx; color: var(--ink-3); margin-bottom: 6rpx; }
.bar-track {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.bar-fill {
  width: 60%;
  min-height: 4rpx;
  background: linear-gradient(180deg, #e8759e, #c2185b);
  border-radius: 6rpx 6rpx 0 0;
  transition: height .35s ease;
}
.bar-label {
  font-size: 18rpx;
  color: var(--ink-3);
  margin-top: 10rpx;
  transform: scale(.9);
}
.chart-empty {
  text-align: center;
  color: var(--ink-3);
  font-size: 25rpx;
  padding: 70rpx 0;
}

.rank {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border-bottom: 2rpx solid var(--line);
  font-size: 27rpx;
}
.rank:last-child { border-bottom: none; }
.rank-no {
  width: 40rpx; height: 40rpx;
  border-radius: 8rpx;
  background: #f0ece9;
  color: var(--ink-3);
  font-size: 23rpx;
  line-height: 40rpx;
  text-align: center;
  flex-shrink: 0;
  font-weight: 600;
}
.rank-no-1 { background: #c2185b; color: #fff; }
.rank-no-2 { background: #e8759e; color: #fff; }
.rank-no-3 { background: #f3b2c8; color: #fff; }
.rank-amount { font-size: 28rpx; }
