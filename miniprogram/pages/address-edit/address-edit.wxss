.page { height: 100vh; display: flex; flex-direction: column; }
.scroll { flex: 1; }
.f-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-bottom: 2rpx solid var(--line);
}
.f-row:last-child { border-bottom: none; }
.f-row-area { align-items: flex-start; }
.f-label { width: 150rpx; color: var(--ink-2); font-size: 27rpx; flex-shrink: 0; }
.f-input { flex: 1; font-size: 28rpx; }
.f-textarea { flex: 1; font-size: 28rpx; min-height: 120rpx; line-height: 1.6; }
.f-arrow { color: var(--ink-3); font-size: 34rpx; }
.del-btn {
  margin: 32rpx 24rpx;
  padding: 26rpx;
  text-align: center;
  background: #fff;
  border-radius: var(--radius);
  color: var(--danger);
  font-size: 28rpx;
}
