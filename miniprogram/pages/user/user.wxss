.page { height: 100vh; display: flex; flex-direction: column; }
.scroll { flex: 1; }

.header {
  background: linear-gradient(160deg, #f8bbd0 0%, #e58aa9 55%, #c2185b 100%);
  padding: 0 24rpx 32rpx;
  color: #fff;
}
.profile { display: flex; align-items: center; gap: 24rpx; padding: 20rpx 0 32rpx; }
.avatar {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.35);
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  flex-shrink: 0;
  padding: 0;
}
.avatar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.avatar-btn::after { border: none; }
.avatar-ph { font-size: 54rpx; }
.profile-info { min-width: 0; }
.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.profile-edit { font-size: 26rpx; opacity: 0.8; }
.profile-level { display: flex; align-items: center; gap: 14rpx; margin-top: 14rpx; }
.level-badge {
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  font-size: 23rpx;
}
.level-discount { font-size: 23rpx; opacity: 0.92; }

.stats {
  display: flex;
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--radius);
  padding: 24rpx 0;
}
.stat { flex: 1; text-align: center; }
.stat-num { display: block; font-size: 34rpx; font-weight: 600; }
.stat-label { display: block; font-size: 22rpx; opacity: 0.85; margin-top: 6rpx; }

.block-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 2rpx solid var(--line);
}
.order-entry { display: flex; padding: 28rpx 0; }
.entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
}
.entry-icon { font-size: 44rpx; }
.entry-text { font-size: 24rpx; color: var(--ink-2); }
.entry-badge {
  position: absolute;
  top: -8rpx;
  right: 50%;
  margin-right: -42rpx;
  min-width: 32rpx; height: 32rpx;
  padding: 0 8rpx;
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
}

.cell-icon { font-size: 36rpx; margin-right: 18rpx; }
.cell-btn {
  background: #fff;
  text-align: left;
  font-size: 28rpx;
  font-weight: 400;
  border-radius: 0;
  line-height: normal;
}
.cell-btn::after { border: none; }

.admin-card .cell-label { color: var(--rose); font-weight: 600; }

.version {
  text-align: center;
  color: var(--ink-3);
  font-size: 22rpx;
  padding: 48rpx 0 24rpx;
}
