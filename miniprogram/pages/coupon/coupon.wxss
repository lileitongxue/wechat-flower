.page { height: 100vh; display: flex; flex-direction: column; }
.tabs { display: flex; background: #fff; border-bottom: 2rpx solid var(--line); }
.tab {
  flex: 1; text-align: center; padding: 24rpx 0;
  font-size: 27rpx; color: var(--ink-2); position: relative;
}
.tab.active { color: var(--rose); font-weight: 600; }
.tab.active::after {
  content: ''; position: absolute; left: 50%; bottom: 0;
  transform: translateX(-50%); width: 44rpx; height: 4rpx;
  background: var(--rose); border-radius: 2rpx;
}
.scroll { flex: 1; }
.wrap { padding: 20rpx 24rpx; }

.cp {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  border-radius: var(--radius);
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
  position: relative;
  overflow: hidden;
}
.cp::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, #d81b60, #c2185b);
}
.cp.used::before { background: #d5cfcb; }
.cp.used .cp-value { color: var(--ink-3); }

.cp-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 170rpx;
  padding-right: 24rpx;
  border-right: 2rpx dashed var(--line);
}
.cp-value { font-size: 44rpx; font-weight: 600; color: var(--rose); }
.cp-threshold { font-size: 21rpx; color: var(--ink-3); margin-top: 6rpx; }
.cp-body { flex: 1; min-width: 0; }
.cp-name { font-size: 28rpx; font-weight: 500; margin-bottom: 8rpx; }
.cp-btn { flex-shrink: 0; }
.cp-use {
  flex-shrink: 0;
  font-size: 25rpx;
  color: var(--rose);
  border: 2rpx solid var(--rose);
  border-radius: 26rpx;
  padding: 8rpx 24rpx;
}
.cp-stamp {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--ink-3);
  transform: rotate(-12deg);
  border: 3rpx solid #ddd6d2;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
}
