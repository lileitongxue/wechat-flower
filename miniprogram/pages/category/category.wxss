.page { height: 100vh; display: flex; flex-direction: column; }

.sortbar {
  display: flex;
  background: #fff;
  border-bottom: 2rpx solid var(--line);
  flex-shrink: 0;
}
.sort-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: var(--ink-2);
  position: relative;
}
.sort-item.active { color: var(--rose); font-weight: 600; }
.sort-item.active::after {
  content: '';
  position: absolute;
  left: 50%; bottom: 0;
  transform: translateX(-50%);
  width: 48rpx; height: 4rpx;
  background: var(--rose);
  border-radius: 2rpx;
}

.body { flex: 1; display: flex; min-height: 0; }

.side {
  width: 180rpx;
  background: #f1eeeb;
  flex-shrink: 0;
}
.side-item {
  padding: 28rpx 12rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--ink-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.side-item.active {
  background: #fff;
  color: var(--rose);
  font-weight: 600;
  position: relative;
}
.side-item.active::before {
  content: '';
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%);
  width: 6rpx; height: 40rpx;
  background: var(--rose);
  border-radius: 0 3rpx 3rpx 0;
}
.side-icon { font-size: 36rpx; }
.side-name { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.main { flex: 1; background: var(--bg); min-width: 0; }
.list { padding: 20rpx; }
.list-item { margin-bottom: 20rpx; }
