<view class="page">
  <scroll-view scroll-y class="scroll">
    <!-- 会员卡 -->
    <view class="vipcard vip-{{info.level}}">
      <view class="vip-top">
        <view>
          <view class="vip-name">{{info.levelName}}</view>
          <view class="vip-sub">{{info.discountText === '无折扣' ? '消费可升级享折扣' : '专享 ' + info.discountText}}</view>
        </view>
        <view class="vip-icon">👑</view>
      </view>
      <view class="vip-progress" wx:if="{{info.nextLevel}}">
        <view class="vip-progress-text">
          再消费 ¥{{gapText}} 升级 {{info.nextLevel.name}}
        </view>
        <view class="vip-bar">
          <view class="vip-bar-fill" style="width: {{info.nextLevel.progress}}%"></view>
        </view>
      </view>
      <view wx:else class="vip-progress">
        <view class="vip-progress-text">已达最高等级，感谢一路同行 🌹</view>
      </view>
    </view>

    <!-- 数据 -->
    <view class="card stats">
      <view class="stat">
        <text class="stat-num">{{info.points || 0}}</text>
        <text class="stat-label">可用积分</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{info.orderCount || 0}}</text>
        <text class="stat-label">累计订单</text>
      </view>
      <view class="stat">
        <text class="stat-num">¥{{spentText}}</text>
        <text class="stat-label">累计消费</text>
      </view>
      <view class="stat" bindtap="goCoupon">
        <text class="stat-num">{{info.couponCount || 0}}</text>
        <text class="stat-label">优惠券</text>
      </view>
    </view>

    <!-- 等级权益 -->
    <view class="section-title">等级权益</view>
    <view class="card card-tight">
      <view wx:for="{{info.levels}}" wx:key="level"
        class="lv {{item.level === info.level ? 'current' : ''}}">
        <view class="lv-left">
          <text class="lv-name">{{item.name}}</text>
          <text wx:if="{{item.level === info.level}}" class="tag">当前</text>
          <text wx:elif="{{item.reached}}" class="tag tag-gray">已达成</text>
        </view>
        <view class="lv-right">
          <text class="t-sm t-rose">{{item.discountText}}</text>
          <text class="t-sm t-muted">积分 {{item.pointsRate}} 倍</text>
          <text class="t-sm t-muted">满 ¥{{item.minSpentText}}</text>
        </view>
      </view>
    </view>

    <!-- 积分说明 -->
    <view class="section-title">积分规则</view>
    <view class="card rules">
      <view class="rule">· 实付 1 元累计 1 积分，等级越高积分倍率越高</view>
      <view class="rule">· 累计消费金额决定会员等级，等级永久有效</view>
      <view class="rule">· 会员折扣在下单时自动生效，可与优惠券叠加</view>
      <view class="rule">· 订单退款后，对应消费额与积分会相应冲减</view>
    </view>

    <view class="safe-bottom"></view>
  </scroll-view>
</view>
