<view class="page">
  <view class="searchbar">
    <view class="sb-input">
      <text class="sb-icon">🔍</text>
      <input class="flex-1" placeholder="搜索玫瑰、康乃馨、永生花…" confirm-type="search"
        value="{{keyword}}" focus bindinput="onInput" bindconfirm="onSearch" />
      <text wx:if="{{keyword}}" class="sb-clear" bindtap="onClear">✕</text>
    </view>
    <text class="sb-cancel" bindtap="onCancel">取消</text>
  </view>

  <scroll-view scroll-y class="scroll" bindscrolltolower="loadMore">
    <!-- 搜索前：历史 + 热词 -->
    <block wx:if="{{!searched}}">
      <view wx:if="{{history.length}}" class="block">
        <view class="block-head">
          <text class="t-md t-bold">搜索历史</text>
          <text class="t-sm t-muted" bindtap="clearHistory">清空</text>
        </view>
        <view class="chips">
          <view wx:for="{{history}}" wx:key="*this" class="chip"
            bindtap="onChip" data-kw="{{item}}">{{item}}</view>
        </view>
      </view>

      <view class="block">
        <view class="block-head">
          <text class="t-md t-bold">大家都在搜</text>
        </view>
        <view class="chips">
          <view wx:for="{{hotWords}}" wx:key="*this" class="chip chip-hot"
            bindtap="onChip" data-kw="{{item}}">{{item}}</view>
        </view>
      </view>
    </block>

    <!-- 搜索结果 -->
    <block wx:else>
      <view wx:if="{{list.length}}" class="result-head">
        找到 {{total}} 个结果
      </view>
      <view class="list">
        <view wx:for="{{list}}" wx:key="_id" class="list-item">
          <product-card product="{{item}}" layout="list" bind:add="onAdd" />
        </view>
      </view>
      <empty-state wx:if="{{!list.length && !loading}}" icon="🔍"
        text="没有找到「{{keyword}}」" hint="换个关键词试试，或看看热门推荐" />
      <view wx:if="{{list.length}}" class="load-more">
        {{ hasMore ? (loading ? '加载中…' : '上拉加载更多') : '— 没有更多了 —' }}
      </view>
    </block>
    <view class="safe-bottom"></view>
  </scroll-view>
</view>
