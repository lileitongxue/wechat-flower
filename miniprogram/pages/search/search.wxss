.page { height: 100vh; display: flex; flex-direction: column; }
.searchbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 2rpx solid var(--line);
}
.sb-input {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 68rpx;
  background: #f4f1ef;
  border-radius: 34rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
}
.sb-icon { font-size: 26rpx; }
.sb-clear { color: var(--ink-3); font-size: 26rpx; padding: 0 6rpx; }
.sb-cancel { font-size: 28rpx; color: var(--ink-2); flex-shrink: 0; }

.scroll { flex: 1; }
.block { padding: 28rpx 24rpx 8rpx; }
.block-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.chips { display: flex; flex-wrap: wrap; gap: 18rpx; }
.chip {
  padding: 12rpx 28rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 25rpx;
  color: var(--ink-2);
}
.chip-hot { background: var(--rose-bg); color: var(--rose); }

.result-head {
  padding: 20rpx 24rpx 0;
  font-size: 24rpx;
  color: var(--ink-3);
}
.list { padding: 20rpx 24rpx 0; }
.list-item { margin-bottom: 20rpx; }
